# Copy this file to .env and fill in real values before running.
# NEVER commit the real .env file to version control.

PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Field-level encryption key for SSN / bank account numbers.
# Must be a 32-byte value, base64 or hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=replace_with_64_char_hex_string

# Database
DB_DIALECT=sqlite
DB_STORAGE=./data/rapidcash.sqlite

# For MySQL, set DB_DIALECT=mysql and fill in the following:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=rapidcash
# DB_USER=your_mysql_user
# DB_PASS=your_mysql_password

# For PostgreSQL / Supabase, set DATABASE_URL or the following variables:
# DATABASE_URL=your_postgres_connection_string
# Or:
# DB_DIALECT=postgres
# DB_HOST=your_postgres_db_host
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=your_postgres_password
# DB_SSL=true

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://rapidcash.credit,https://rapidcash.credit,http://www.rapidcash.credit,https://www.rapidcash.credit

# Admin bootstrap (used once by scripts/createAdmin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_immediately
